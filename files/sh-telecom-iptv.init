#!/bin/sh /etc/rc.common
# IPTV daemon procd init (compatible with OpenWrt 19.07 .. 25.12)

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/iptvd
CONF=/etc/config/sh-telecom-iptv

start_service() {
	config_load sh-telecom-iptv
	config_get_bool disabled main disabled 0
	[ "$disabled" = "1" ] && return

	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF"
	procd_set_param respawn \
		${respawn_threshold:-3600} ${respawn_timeout:-5} \
		${respawn_retry:-0}
	procd_set_param stdout 1
	procd_set_param stderr 1
	# config change restarts the daemon
	procd_set_param file "$CONF"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "sh-telecom-iptv"
}
